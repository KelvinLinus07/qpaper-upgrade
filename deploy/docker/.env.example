# QPaper Studio — standalone Docker Compose sample
# Use ./deploy/docker/setup.sh to create .env and generate both secrets.
# LOCAL-ONLY defaults: http://localhost:8080, not for a public server.
# For production, follow deploy/docker/README.md and use HTTPS + real domain.

APP_URL=http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
COOKIE_SECURE=false

POSTGRES_DB=qpaper
POSTGRES_USER=qpaper
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_SCRIPT
JWT_SECRET=GENERATE_WITH_SETUP_SCRIPT
DB_POOL_MAX=10

ALLOW_SELF_REGISTRATION=false

# Select storage provider: r2 (Cloudflare) or s3 (existing AWS S3).
# Default remains s3 for upgrades unless you explicitly choose r2.
STORAGE_PROVIDER=s3

# Cloudflare R2: set STORAGE_PROVIDER=r2 and fill in these variables.
# Get Account ID and bucket-scoped API keys in Cloudflare Dashboard -> R2.
# Set R2_ENDPOINT explicitly, OR set R2_ACCOUNT_ID to derive the endpoint.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
# Optional for NEW images. Retain your old value to resolve previously saved R2 URLs.
# New image URLs are served privately through /api/uploads/image/...
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AWS S3 remains supported when STORAGE_PROVIDER=s3.
# AWS_REGION also controls the region for optional AWS SES email.
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
# AWS credentials are for AWS-only features (S3 or SES), NOT R2.
# Leave blank on AWS EC2 with a suitable IAM instance profile:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Configure SMTP or AWS SES to actually send password resets/invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SES_FROM_EMAIL=
