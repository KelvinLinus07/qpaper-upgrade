PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qpaper
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Choose r2 for Cloudflare, or s3 for AWS (default).
STORAGE_PROVIDER=s3

# R2: leave R2_ENDPOINT blank to use https://R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# AWS S3 option, and AWS region for optional SES email:
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PUBLIC_BASE_URL=
# AWS credentials belong to AWS S3 / AWS SES, not Cloudflare R2:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Administrator

# Public frontend URL used in invitations and password-reset email links
APP_URL=http://localhost:5173
# Optional SMTP transport (required for password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Development only: log reset links in backend terminal, never enable in production
DEV_SHOW_RESET_LINKS=false

# AWS ECS/Fargate mode (instead of DATABASE_URL) uses DB_HOST, DB_USER,
# DB_PASSWORD, DB_NAME, and DB_SSL_CA_FILE (see deploy/aws/TERRAFORM.md).
# DB_SSL_CA_FILE=/app/certs/global-bundle.pem
# SES_FROM_EMAIL=verified-sender@example.com
# ALLOW_SELF_REGISTRATION=false
# ADMIN_BOOTSTRAP_SECRET_ARN=arn:aws:secretsmanager:...
# TRUST_PROXY_HOPS=2
